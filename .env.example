# --- Required ---

# YouTube Data API v3 key (free):
# console.cloud.google.com -> create project -> enable "YouTube Data API v3"
# -> Credentials -> Create API key
YOUTUBE_API_KEY=

# --- Required in production, optional locally ---

# Neon Postgres connection string (free tier: neon.tech).
# Leave unset for local development and an embedded PGlite database is
# created in .data/ automatically — zero setup.
DATABASE_URL=

# Protects the feed behind a password. Leave unset to run without auth
# (fine locally, not recommended for a deployed site).
APP_PASSWORD=

# Shared secret between the Netlify scheduled function and /api/cron.
# Any long random string, e.g. `openssl rand -hex 24`.
CRON_SECRET=

# --- Optional ---

# Apify API token (console.apify.com -> Settings -> API & Integrations).
# Used as a transcript fallback on HOSTED deployments, where YouTube blocks
# caption fetching from datacenter IPs. ~$0.005/video against Apify's
# permanently recurring $5/month free credit. Leave unset locally — the
# free InnerTube route works from residential IPs.
APIFY_TOKEN=

# Override the Apify Actor used for transcripts ("username~actor-name")
# APIFY_TRANSCRIPT_ACTOR=starvibe~youtube-video-transcript

# Firecrawl API key (firecrawl.dev). Backup for Apify on HOSTED deployments:
# used only after Apify fails 3 times in a row, for 30 minutes at a time
# (1 credit per new video). Leave unset to use Apify alone.
FIRECRAWL_API_KEY=

# Gemini API key for on-demand video summaries (free tier: aistudio.google.com)
GEMINI_API_KEY=

# Model fallback chain as "model:daily-limit" pairs, tried in this order.
# The app tracks its own daily usage and skips models that have used up
# their day; a busy (503), out-of-quota or unknown model moves on to the
# next one. Check your limits at aistudio.google.com -> Rate Limit.
# GEMINI_MODELS=gemini-3.5-flash-lite:500,gemini-3.1-flash-lite:500,gemini-3.8-flash:20,gemini-3.7-flash:20

# Force one model to the front of the chain (leave unset for the order above)
# GEMINI_MODEL=gemini-3.5-flash-lite

# App-level cap on TOTAL Gemini calls per day, across all models — an
# independent safety net over the per-model chain limits.
# GEMINI_DAILY_LIMIT=100

# Summaries/asks/transcripts read the video's captions when available
# (cheap). For videos with no captions, Gemini watches the video itself
# (low fps + low res, ~40 tokens per second of footage) — allowed up to
# this length so one request stays inside the free per-request token limit.
# 0 disables watching entirely. Defaults: 90 locally, 0 on Netlify (its
# serverless timeout kills a watch mid-flight, wasting tokens for nothing).
# GEMINI_WATCH_MAX_MINUTES=90

# How many months of history to backfill when a channel is added (and when
# you RE-SYNC a channel). Default 12. Lower it if a very prolific channel's
# backfill brushes the hosting function timeout.
# BACKFILL_MONTHS=12
