   "roundness": null
  },
  {
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "seed": 2096161154,
   "version": 1,
   "versionNonce": 621269525,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1783655669077,
   "link": null,
   "locked": false,
   "id": "el-2g-pq7yhj",
   "type": "text",
   "x": 1090,
   "y": 1492,
   "width": 391.87500000000006,
   "height": 109.375,
   "backgroundColor": "transparent",
   "text": "1  Postgres owns the data — YouTube is a sync source\n2  idempotency everywhere (natural unique keys)\n3  cheapest API call = the one never made (cache forever)\n4  quotas are first-class design constraints\n5  graceful degradation over hard dependency\n6  config over code (env vars + genre rows)\n7  stateless queries — badges match what clicks reveal",
   "fontSize": 12.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "1  Postgres owns the data — YouTube is a sync source\n2  idempotency everywhere (natural unique keys)\n3  cheapest API call = the one never made (cache forever)\n4  quotas are first-class design constraints\n5  graceful degradation over hard dependency\n6  config over code (env vars + genre rows)\n7  stateless queries — badges match what clicks reveal",
   "autoResize": true,
   "lineHeight": 1.25,
   "roundness": null
  },
  {
