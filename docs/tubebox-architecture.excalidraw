   "width": 264,
   "height": 18.75,
   "backgroundColor": "transparent",
   "text": "PRINCIPLES (every feature obeys)",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "PRINCIPLES (every feature obeys)",
