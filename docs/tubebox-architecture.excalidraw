  },
  {
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "seed": 1604954232,
   "version": 1,
   "versionNonce": 1418393826,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1783655669077,
   "link": null,
   "locked": false,
   "id": "el-2j-car9n4",
   "type": "text",
   "x": 670,
   "y": 142,
   "width": 250.8,
   "height": 225,
   "backgroundColor": "transparent",
   "text": "· yt3.ggpht.com avatars 429 with a\n  Referer → referrerPolicy=no-referrer\n· Turbopack serves stale CSS →\n  kill server, rm -rf .next\n· PGlite: mkdir parent first; never\n  cache a failed DB init\n· Netlify functions: 10s free timeout\n  → watch-once disabled hosted\n· custom CSS classes beat Tailwind\n  utilities (emitted later) — declare\n  color modifiers after base classes\n· TPM is a speed limit; RPD is the\n  budget (dashboard shows 28d peak)\n· InnerTube blocked from datacenter\n  IPs → Apify fallback hosted",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "· yt3.ggpht.com avatars 429 with a\n  Referer → referrerPolicy=no-referrer\n· Turbopack serves stale CSS →\n  kill server, rm -rf .next\n· PGlite: mkdir parent first; never\n  cache a failed DB init\n· Netlify functions: 10s free timeout\n  → watch-once disabled hosted\n· custom CSS classes beat Tailwind\n  utilities (emitted later) — declare\n  color modifiers after base classes\n· TPM is a speed limit; RPD is the\n  budget (dashboard shows 28d peak)\n· InnerTube blocked from datacenter\n  IPs → Apify fallback hosted",
   "autoResize": true,
   "lineHeight": 1.25,
   "roundness": null
  }
 ],
 "appState": {
