   "y": 920.4,
   "width": 199.65,
   "height": 137.5,
   "backgroundColor": "transparent",
   "text": "CHAIN (each step → null on fail):\n① cached videos.transcript\n② InnerTube ANDROID client\n    (residential IPs only —\n    datacenter IPs blocked)\n③ Apify actor (hosted only,\n    $0.005/run): try lang=en,\n    retry once with default lang\n④ null → caller decides\ncap 150K chars",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "CHAIN (each step → null on fail):\n① cached videos.transcript\n② InnerTube ANDROID client\n    (residential IPs only —\n    datacenter IPs blocked)\n③ Apify actor (hosted only,\n    $0.005/run): try lang=en,\n    retry once with default lang\n④ null → caller decides\ncap 150K chars",
   "autoResize": true,
   "lineHeight": 1.25,
   "roundness": null
  },
